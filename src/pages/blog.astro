---
import Site from '../layouts/Site.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { sitePath } from '../lib/paths.mjs';
const posts = await getPosts();
---
<Site title="Writing" section="Writing" canonical={sitePath('blog.html')}>
  <p class="eyebrow">01 / Writing</p>
  <h1 class="page-title">Writing</h1>
  <p class="intro">技術記事、書評、読んだ資料の記録。</p>
  <div class="search"><label for="article-search">記事を検索</label><input type="search" id="article-search" placeholder="タイトル・本文・分類" /><p id="search-status" aria-live="polite"></p></div>
  <PostList posts={posts} />
  <script>
    const input = document.querySelector<HTMLInputElement>('#article-search');
    const items = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    const status = document.querySelector('#search-status');
    input?.addEventListener('input', () => {
      const terms = input.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
      let count = 0;
      for (const item of items) {
        item.hidden = !terms.every(term => (item.dataset.search || '').toLocaleLowerCase().includes(term));
        if (!item.hidden) count++;
      }
      if (status) status.textContent = terms.length ? count + ' 件' : '';
    });
  </script>
</Site>
